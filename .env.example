# ── Application ──────────────────────────────────────────────
# MongoDB connection (local or Atlas)
MONGO_URL=mongodb://localhost:27017

# Database name
DB_NAME=eurovault

# JWT Secret Key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here

# Admin Panel Credentials — CHANGE THESE before going to production
ADMIN_USERNAME=brokereurope
ADMIN_PASSWORD=Europeinvest

# ── Frontend ──────────────────────────────────────────────────
# Backend API URL (no trailing slash)
REACT_APP_BACKEND_URL=http://localhost:8001

# ── Optional: Email (for real email sending) ─────────────────
# Uncomment and fill in if you want real email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password

# ── Optional: MongoDB Atlas ───────────────────────────────────
# Use this instead of local MongoDB for production
# MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true
